# Force LF on shell scripts so they work on Linux servers regardless of
# the contributor's autocrlf setting. Without this, Windows-side commits
# of .sh files end up with CRLF and fail on Linux with cryptic errors.
*.sh text eol=lf

# env.init templates are sourced by bash on Linux — must be LF
scripts/migration-test/env.init.example text eol=lf
scripts/migration-prod/env.init.example text eol=lf
