# 复制为 env.init,填好实际值后被各脚本自动 source
# 安全提示:env.init 含 GH_TOKEN,默认已被 .gitignore 忽略,**不要 commit**

# ---- GitHub PAT ----
# 需要对 PROD_REPO 有 read、对 TEST_REPO 有 read+write 权限
# Classic PAT: 勾 repo scope
# Fine-grained PAT: 把这两个仓库都加进 Repository access,Contents 给 Read and write
export GH_TOKEN='<填你的 PAT>'

# ---- 仓库坐标(默认值适用于本团队,需要时修改) ----
export PROD_REPO='hashSTACS-Global/pivot-database'
export TEST_REPO='hashSTACS-Global/pivot-database-migration-test'
export PIVOT_REPO='hashSTACS-Global/team-pivot-web'

# ---- Pivot 代码分支(含本次迁移脚本) ----
export PIVOT_BRANCH='feat/pivot-matter'

# ---- 工作根目录(放 mirror、test-workspace、报告) ----
export WORKDIR="$HOME/tmp/pivot-migration-test"

# ---- 生产 data.db 路径 ----
# 迁移脚本通过 file:URI?mode=ro 只读打开此文件,绝不写入,可以**直接指向生产 db**
# 默认: 测试机就是生产机时,/opt/team-pivot-web/var/data.db 即生产路径
# 测试机 ≠ 生产机时,把生产 data.db scp/rsync 到测试机后,改成那个路径
# 留空字符串 → 走 --no-users-db,mention 解析跌回 ou_xxxxx open_id 兜底
export PROD_DB_PATH='/opt/team-pivot-web/var/data.db'

# ---- Git 身份(迁移 commit 的 author/committer) ----
export GIT_USER_EMAIL='migration@pivot.local'
export GIT_USER_NAME='migration'
