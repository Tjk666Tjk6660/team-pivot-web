# 复制为 env.init,填好实际值后被各脚本自动 source
# env.init 不含敏感 token (workspace 自己的 .git/config 已带 token),
# 但仍被 .gitignore 忽略,防止意外提交本地化路径

# ---- workspace 路径 ----
# Pivot 数据 workspace 的本地 git 仓库,迁移在此 in-place 进行
# 这是 Pivot 服务运行时的 var/git/<repo-name>/ 目录,含全部 thread / matter index / MD
export WORKSPACE='/opt/team-pivot-web/var/git/pivot-database'

# ---- bundle + db 备份目录 ----
# 02-bundle-backup.sh 会在此目录产出:
#   pre-migration-<UTC>.bundle      — workspace 的 git history
#   pre-migration-<UTC>.data.db     — data.db 文件副本(完整,不是只读快照)
# 同时是迁移 report 落点
export BACKUP_DIR='/opt/team-pivot-web/var/backup'

# ---- 生产 data.db 路径 ----
# 迁移脚本通过 file:URI?mode=ro 只读直连,绝不写入,可安全指向生产 db
# 留空字符串 → 走 --no-users-db 兜底,mention 落 ou_xxxxx 字面量
export PROD_DB_PATH='/opt/team-pivot-web/var/data.db'

# ---- systemd 服务名 ----
# 脚本不主动 stop/start 服务:
# - 01-preflight.sh 校验"已停"(systemctl is-active 返 inactive 才放行)
# - 07-restart-service.sh 显式 start + 烟测
export SERVICE_NAME='team-pivot-web'

# ---- 期望分支 ----
# pivot-matter 已合 main 后默认 main
# 校验 PIVOT_CODE 与 WORKSPACE 都在这条分支上
export EXPECTED_BRANCH='main'

# ---- Git 身份(迁移 commit 的 author/committer) ----
# 仅在 workspace 本仓库生效(local config),不污染全局
export GIT_USER_EMAIL='migration@pivot.local'
export GIT_USER_NAME='migration'
