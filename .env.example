FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=replace-with-random-32-bytes
WEB_DEV_ORIGIN=http://localhost:5173
DATA_DIR=./var
# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Feishu card notifications on publish (set to false for dev if you don't want spam)
NOTIFY_ENABLED=true

# Relevance scanner
# - Startup scan always runs. Cold vs warm is decided by whether the
#   relevance_events table is empty (cold-start writes rows as already-read
#   so historical activity doesn't surface as retroactive unread badges).
# - RELEVANCE_SCAN_INTERVAL_MINUTES: periodic background scan interval, in
#   minutes. Default 60 (i.e. hourly). Minimum 1.
RELEVANCE_SCAN_INTERVAL_MINUTES=60

# Workspace repo / visibility / server write token / client readonly token
# are configured in the web Admin page and stored in SQLite settings.
