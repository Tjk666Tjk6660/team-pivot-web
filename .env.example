FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=replace-with-random-32-bytes
WEB_DEV_ORIGIN=http://localhost:5173
DATA_DIR=./var
# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Feishu card notifications on publish (set to false for dev if you don't want spam)
NOTIFY_ENABLED=true

# Relevance scanner
# - Startup scan always runs. Cold vs warm is decided by whether the
#   relevance_events table is empty (cold-start writes rows as already-read
#   so historical activity doesn't surface as retroactive unread badges).
# - RELEVANCE_SCAN_INTERVAL_MINUTES: periodic background scan interval, in
#   minutes. Default 60 (i.e. hourly). Minimum 1.
RELEVANCE_SCAN_INTERVAL_MINUTES=60

# Workspace repo / visibility / server write token / client readonly token
# are configured in the web Admin page and stored in SQLite settings.

# ─────────────────────────────────────────────────────────────────────────────
# Daily Report · 本地连生产数据预览(可选,默认不启用)
# ─────────────────────────────────────────────────────────────────────────────
# 用途:本地启动主服务 + 前端,在 /admin → 日报配置 → 手动触发 跑一次,
# 用真实生产数据看 AI 输出 / 调 prompt / 验证视觉,但**绝不写入生产**。
#
# 仅影响日报路径(scheduler 定时跑 + UI 手动触发)。其他业务(matter CRUD /
# 评论 / AI 助手)仍走 /admin 配置的 dev workspace + 主 data.db,互不串台。
#
# 安全保证(三道防线):
#   1. ReadOnlyUserView 通过 sqlite `file:...?mode=ro` URI 打开 users db,
#      DDL/DML 在 sqlite 层面被拒,代码 bug 也写不进。
#   2. runner 只调用 collect_matter_events 纯读 YAML;不实例化 Workspace
#      → 不会 git pull/push 任何远端。
#   3. 这两个变量都是可选的:注释掉或删掉就回到正常 dev 行为。
#
# 准备工作(只做一次):
#   - 把生产 pivot-database 仓库 clone 到 tests/test_output/git/pivot-database
#     (已忽略,不入 git;后续手动 `git -C ... pull` 就能刷数据)
#   - 把生产 data.db 拷成快照放到 tests/test_output/prod-data-snapshot.db
#     (用来读真实 users 表给 personal 视角用)
#
# 启动后日志会有:
#   INFO server.app daily-report index dir overridden: <path>
#   INFO server.app daily-report users db overridden: <path> (read-only)
#
# 启用方式:取消下面两行的注释。
# DAILY_REPORT_INDEX_DIR_OVERRIDE=tests/test_output/git/pivot-database/index
# DAILY_REPORT_USERS_DB_PATH=tests/test_output/prod-data-snapshot.db
