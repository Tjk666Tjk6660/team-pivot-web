#!/usr/bin/env bash
# pivot-cli — lightweight Pivot Agent CLI (curl wrapper)
# No runtime dependencies beyond curl and a POSIX shell.
#
# Config: ~/.pivot-cli.conf (created by 'pivot-cli login')
#   PIVOT_ENDPOINT=https://xxx.saas.enclaws.com
#   PIVOT_TOKEN=ptk_xxx

set -euo pipefail

CONFIG_FILE="$HOME/.pivot-cli.conf"

# ---- helpers ----

die() { echo "ERROR: $*" >&2; exit 1; }

load_config() {
  [ -f "$CONFIG_FILE" ] || die "Not logged in. Run: pivot-cli login --endpoint <url> --token <token>"
  PIVOT_ENDPOINT=$(grep '^PIVOT_ENDPOINT=' "$CONFIG_FILE" | cut -d= -f2-)
  PIVOT_TOKEN=$(grep '^PIVOT_TOKEN=' "$CONFIG_FILE" | cut -d= -f2-)
  [ -n "$PIVOT_ENDPOINT" ] || die "PIVOT_ENDPOINT not set in $CONFIG_FILE"
  [ -n "$PIVOT_TOKEN" ] || die "PIVOT_TOKEN not set in $CONFIG_FILE"
}

rpc() {
  local method="$1"
  local params="$2"
  curl -s -X POST "${PIVOT_ENDPOINT}/api/rpc" \
    -H "Authorization: Bearer ${PIVOT_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"method\": \"${method}\", \"params\": ${params}}"
}

# ---- commands ----

cmd_login() {
  local endpoint="" token=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --endpoint) endpoint="$2"; shift 2 ;;
      --token)    token="$2";    shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  [ -n "$endpoint" ] || die "Missing --endpoint"
  [ -n "$token" ]    || die "Missing --token"
  cat > "$CONFIG_FILE" <<EOF
PIVOT_ENDPOINT=${endpoint}
PIVOT_TOKEN=${token}
EOF
  chmod 600 "$CONFIG_FILE"
  echo "Logged in. Config saved to $CONFIG_FILE"
}

cmd_discuss() {
  load_config
  local sub="${1:-}"; shift 2>/dev/null || true

  # Parse all --key value pairs
  local category="" thread="" title="" content="" mention="" comments="" reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --category) category="$2"; shift 2 ;;
      --thread)   thread="$2";   shift 2 ;;
      --title)    title="$2";    shift 2 ;;
      --content)  content="$2";  shift 2 ;;
      --mention)  mention="$2";  shift 2 ;;
      --comments) comments="$2"; shift 2 ;;
      --reason)   reason="$2";   shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  case "$sub" in
    new)
      [ -n "$content" ] || die "Usage: pivot-cli discuss new --category <cat> --title <title> --content <text> [--mention <users>] [--comments <text>]"
      rpc "app.pivot.discuss-new" "{\"category\":\"${category}\",\"title\":\"${title}\",\"content\":\"${content}\",\"mention_users\":\"${mention}\",\"mention_comments\":\"${comments}\"}"
      ;;
    reply)
      [ -n "$category" ] || die "Usage: pivot-cli discuss reply --category <cat> --thread <thread> --content <text> [--mention <users>] [--comments <text>]"
      [ -n "$thread" ] || die "reply requires --thread"
      [ -n "$content" ] || die "reply requires --content"
      rpc "app.pivot.discuss-reply" "{\"category\":\"${category}\",\"thread\":\"${thread}\",\"content\":\"${content}\",\"mention_users\":\"${mention}\",\"mention_comments\":\"${comments}\"}"
      ;;
    list)
      rpc "app.pivot.discuss-list" "{\"category\":\"${category}\"}"
      ;;
    inbox)
      rpc "app.pivot.discuss-inbox" "{}"
      ;;
    read)
      [ -n "$category" ] || die "Usage: pivot-cli discuss read --category <cat> --thread <thread>"
      [ -n "$thread" ] || die "read requires --thread"
      rpc "app.pivot.discuss-read" "{\"category\":\"${category}\",\"thread\":\"${thread}\"}"
      ;;
    close|pending)
      [ -n "$category" ] || die "Usage: pivot-cli discuss ${sub} --category <cat> --thread <thread>"
      [ -n "$thread" ] || die "${sub} requires --thread"
      rpc "app.pivot.discuss-status" "{\"category\":\"${category}\",\"thread\":\"${thread}\",\"action\":\"${sub}\",\"reason\":\"\"}"
      ;;
    reopen)
      [ -n "$category" ] || die "Usage: pivot-cli discuss reopen --category <cat> --thread <thread> --reason <text>"
      [ -n "$thread" ] || die "reopen requires --thread"
      [ -n "$reason" ] || die "reopen requires --reason"
      rpc "app.pivot.discuss-status" "{\"category\":\"${category}\",\"thread\":\"${thread}\",\"action\":\"reopen\",\"reason\":\"${reason}\"}"
      ;;
    summarize)
      [ -n "$category" ] || die "Usage: pivot-cli discuss summarize --category <cat> --thread <thread>"
      [ -n "$thread" ] || die "summarize requires --thread"
      rpc "app.pivot.discuss-summarize" "{\"category\":\"${category}\",\"thread\":\"${thread}\"}"
      ;;
    result)
      [ -n "$category" ] || die "Usage: pivot-cli discuss result --category <cat> --thread <thread>"
      [ -n "$thread" ] || die "result requires --thread"
      rpc "app.pivot.discuss-result" "{\"category\":\"${category}\",\"thread\":\"${thread}\"}"
      ;;
    *)
      die "Unknown discuss command: ${sub}\nAvailable: new | reply | list | inbox | read | close | pending | reopen | summarize | result"
      ;;
  esac
}

cmd_file() {
  load_config
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    fetch)
      local paths=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --paths) paths="$2"; shift 2 ;;
          *) die "Unknown option: $1" ;;
        esac
      done
      [ -n "$paths" ] || die "Usage: pivot-cli file fetch --paths <path1,path2,...>"
      rpc "app.pivot.file-fetch" "{\"paths\":\"${paths}\"}"
      ;;
    *)
      die "Unknown file command: ${sub}\nAvailable: fetch"
      ;;
  esac
}

cmd_monitor() {
  load_config
  local sub="${1:-}"; shift 2>/dev/null || true

  local window_hours="" mention_window_hours=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --window-hours)         window_hours="$2";         shift 2 ;;
      --mention-window-hours) mention_window_hours="$2"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  case "$sub" in
    scan)
      rpc "app.pivot.monitor-scan" "{\"window_hours\":\"${window_hours}\",\"mention_window_hours\":\"${mention_window_hours}\"}"
      ;;
    *)
      die "Unknown monitor command: ${sub}\nAvailable: scan"
      ;;
  esac
}

cmd_help() {
  cat <<'HELP'
pivot-cli -- Team-Pivot Agent CLI

Usage: pivot-cli <command> --key <value> ...

Commands:
  login      --endpoint <url> --token <token>
  discuss new       --category <cat> --title <title> --content <text> [--mention <users>] [--comments <text>]
  discuss reply     --category <cat> --thread <thread> --content <text> [--mention <users>] [--comments <text>]
  discuss list      [--category <cat>]
  discuss inbox
  discuss read      --category <cat> --thread <thread>
  discuss close     --category <cat> --thread <thread>
  discuss pending   --category <cat> --thread <thread>
  discuss reopen    --category <cat> --thread <thread> --reason <text>
  discuss summarize --category <cat> --thread <thread>
  discuss result    --category <cat> --thread <thread>
  monitor scan      [--window-hours <N>] [--mention-window-hours <N>]
  file fetch        --paths <path1,path2,...>

All parameters must use --key <value> format.
All commands return JSON. Pipe to jq for pretty-printing:
  pivot-cli discuss list | jq .
HELP
}

# ---- main ----

case "${1:-}" in
  login)   shift; cmd_login "$@" ;;
  discuss) shift; cmd_discuss "$@" ;;
  monitor) shift; cmd_monitor "$@" ;;
  file)    shift; cmd_file "$@" ;;
  help|--help|-h) cmd_help ;;
  "") cmd_help ;;
  *) die "Unknown command: $1. Run 'pivot-cli help' for usage." ;;
esac
